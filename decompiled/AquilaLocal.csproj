<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <AssemblyName>Aquila Local</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <TargetFramework>netcoreapp8.0</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>11.0</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="controltheme.baml" />
    <None Remove="personalitywindow.baml" />
    <None Remove="mainwindow.baml" />
    <None Remove="app.baml" />
    <EmbeddedResource Include="controltheme.baml" LogicalName="controltheme.baml" />
    <EmbeddedResource Include="personalitywindow.baml" LogicalName="personalitywindow.baml" />
    <EmbeddedResource Include="mainwindow.baml" LogicalName="mainwindow.baml" />
    <EmbeddedResource Include="app.baml" LogicalName="app.baml" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="PresentationCore" />
    <Reference Include="UglyToad.PdfPig" />
    <Reference Include="NAudio.Core" />
    <Reference Include="Microsoft.ML.OnnxRuntime" />
    <Reference Include="System.Speech" />
    <Reference Include="Emoji.Wpf" />
    <Reference Include="NAudio.WinMM" />
    <Reference Include="UglyToad.PdfPig.DocumentLayoutAnalysis" />
    <Reference Include="UglyToad.PdfPig.Fonts" />
    <Reference Include="UglyToad.PdfPig.Core" />
  </ItemGroup>
</Project>