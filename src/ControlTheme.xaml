<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="PopupSurface" Color="#202D3C" />
  <SolidColorBrush x:Key="ControlTrack" Color="#263747" />
  <SolidColorBrush x:Key="ControlThumb" Color="#8097AC" />
  <SolidColorBrush x:Key="ControlHover" Color="#B6CADC" />
  <SolidColorBrush x:Key="ContextTargetInk" Color="#AECDF3" />
  <SolidColorBrush x:Key="ContextAdvisoryInk" Color="#F3CD8C" />
  <SolidColorBrush x:Key="ContextWarningInk" Color="#FFAD9F" />
  <Style x:Key="DarkFocusVisual" TargetType="{x:Type Control}">
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate>
          <Border Margin="2" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="4" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="Background" Value="{StaticResource PopupSurface}" />
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="BorderBrush" Value="{StaticResource ControlThumb}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="MaxWidth" Value="380" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" Padding="{TemplateBinding Control.Padding}" CornerRadius="5" SnapsToDevicePixels="True">
            <ContentPresenter>
              <FrameworkElement.Resources>
                <ResourceDictionary>
                  <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
                    <Setter Property="TextWrapping" Value="Wrap" />
                  </Style>
                </ResourceDictionary>
              </FrameworkElement.Resources>
            </ContentPresenter>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="{x:Type CheckBox}" TargetType="{x:Type CheckBox}">
    <Setter Property="Foreground" Value="{DynamicResource Ink}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource DarkFocusVisual}" />
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Background="#00FFFFFF">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Name="CheckSurface" Width="16" Height="16" Margin="0,0,7,0" VerticalAlignment="Center" BorderThickness="1" CornerRadius="3" Background="{StaticResource ControlTrack}" BorderBrush="{StaticResource ControlThumb}">
              <Grid>
                <Path Name="CheckMark" Data="M1,5 L4,8 L10,2" Stroke="{DynamicResource Accent}" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
                <Border Name="CheckDash" Width="8" Height="2" Background="{DynamicResource Accent}" Visibility="Collapsed" />
              </Grid>
            </Border>
            <ContentPresenter Grid.Column="1" RecognizesAccessKey="True" VerticalAlignment="{TemplateBinding Control.VerticalContentAlignment}" />
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="CheckMark" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="{x:Null}">
              <Setter TargetName="CheckDash" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="CheckSurface" Property="Border.BorderBrush" Value="{StaticResource ControlHover}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="CheckSurface" Value="{DynamicResource Accent}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Value="{DynamicResource Muted}" Property="Foreground" />
              <Setter TargetName="CheckSurface" Property="UIElement.Opacity" Value="0.65" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TrackButton" TargetType="{x:Type RepeatButton}">
    <Setter Property="Focusable" Value="False" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RepeatButton}">
          <Border Background="#00FFFFFF" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="TrackThumb" TargetType="{x:Type Thumb}">
    <Setter Property="Background" Value="{StaticResource ControlThumb}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Thumb}">
          <Border Background="{TemplateBinding Control.Background}" CornerRadius="4" SnapsToDevicePixels="True" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Background" Value="{StaticResource ControlHover}" />
      </Trigger>
      <Trigger Property="Thumb.IsDragging" Value="True">
        <Setter Property="Background" Value="{DynamicResource Accent}" />
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="{x:Type ScrollBar}" TargetType="{x:Type ScrollBar}">
    <Setter Property="Width" Value="12" />
    <Setter Property="MinWidth" Value="12" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ScrollBar}">
          <Grid Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Border Margin="2,0" CornerRadius="4" Background="{StaticResource ControlTrack}" />
            <Track Name="PART_Track" IsDirectionReversed="True" Margin="2,0">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource TrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb MinHeight="20" Style="{StaticResource TrackThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource TrackButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="ScrollBar.Orientation" Value="Horizontal">
        <Setter Property="Width" Value="Auto" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type ScrollBar}">
              <Grid Background="#00FFFFFF" SnapsToDevicePixels="True">
                <Border Margin="0,2" CornerRadius="4" Background="{StaticResource ControlTrack}" />
                <Track Name="PART_Track" Margin="0,2">
                  <Track.DecreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageLeftCommand" Style="{StaticResource TrackButton}" />
                  </Track.DecreaseRepeatButton>
                  <Track.Thumb>
                    <Thumb MinWidth="20" Style="{StaticResource TrackThumb}" />
                  </Track.Thumb>
                  <Track.IncreaseRepeatButton>
                    <RepeatButton Command="ScrollBar.PageRightCommand" Style="{StaticResource TrackButton}" />
                  </Track.IncreaseRepeatButton>
                </Track>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Trigger>
    </Style.Triggers>
  </Style>
  <Style x:Key="ContextSliderStyle" TargetType="{x:Type Slider}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{StaticResource DarkFocusVisual}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Slider}">
          <Grid Height="22" Background="#00FFFFFF">
            <Border Height="4" Margin="8,0" CornerRadius="2" Background="{StaticResource ControlThumb}" />
            <Track Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource TrackButton}" />
              </Track.DecreaseRepeatButton>
              <Track.Thumb>
                <Thumb Width="16" Height="20" Style="{StaticResource TrackThumb}" />
              </Track.Thumb>
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource TrackButton}" />
              </Track.IncreaseRepeatButton>
            </Track>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>