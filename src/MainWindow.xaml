<?xml version="1.0" encoding="utf-8"?>
<local:AquilaWindow x:Class="AquilaLocal.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:AquilaLocal" Title="Aquila Local" Width="1360" Height="900" MinWidth="1000" MinHeight="680" WindowStartupLocation="CenterScreen" AllowDrop="True" Closing="Window_Closing" PreviewDragOver="Files_DragOver" PreviewDragLeave="Files_DragLeave" PreviewDrop="Files_Drop" PreviewKeyDown="Window_PreviewKeyDown">
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="272" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <!-- ================= Sidebar ================= -->
    <Border Grid.Column="0" Background="{StaticResource Bg.Sidebar}" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,1,0">
      <DockPanel Margin="12">
        <!-- Brand -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Height="40" Margin="4,4,4,12">
          <Border Width="28" Height="28" CornerRadius="8" Background="{StaticResource Accent.Subtle}" VerticalAlignment="Center">
            <TextBlock Text="A" Foreground="{StaticResource Accent}" FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="Aquila" Style="{StaticResource Type.Subtitle}" Margin="10,0,0,0" VerticalAlignment="Center" />
        </StackPanel>
        <Button Name="NewButton" DockPanel.Dock="Top" Height="40" HorizontalContentAlignment="Left" Margin="0,0,0,16" ToolTip="Start a new conversation (Ctrl+N)" Click="New_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE710;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="New chat" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock DockPanel.Dock="Top" Text="Chats" Style="{StaticResource Type.Label}" Margin="8,0,0,6" />

        <!-- Footer: privacy line -->
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Height="28" Margin="8,0,0,0" ToolTip="Aquila runs entirely on this computer. Optional internet access only contacts search providers and websites when you allow it.">
          <TextBlock Text="&#xEA18;" FontFamily="{StaticResource Font.Icon}" FontSize="12" Foreground="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
          <TextBlock Text="On this device · v2.1" Style="{StaticResource Type.Caption}" VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Name="VoiceStatusText" DockPanel.Dock="Bottom" Text="Voice off" Style="{StaticResource Type.Caption}" TextTrimming="CharacterEllipsis" Margin="8,4,8,4" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
        <!-- Tools -->
        <UniformGrid DockPanel.Dock="Bottom" Columns="2" Margin="0,0,0,4">
          <Button Name="VoiceButton" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,2,4" Padding="10,0" Click="Voice_Click" ToolTip="How Aquila sounds when it reads replies aloud">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE720;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="Voice" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="2,0,0,4" Padding="10,0" Click="Internet_Click" ToolTip="Choose whether Aquila may look things up online">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE774;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="Internet" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Name="MemoriesButton" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,2,0" Padding="10,0" Click="Memories_Click" ToolTip="What Aquila remembers about you">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE8F1;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="Memories" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="2,0,0,0" Padding="10,0" Click="Avatar_Click" ToolTip="Change the avatar's pictures and gestures">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
              <TextBlock Text="Avatar" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </UniformGrid>
        <!-- Multi-persona scenes -->
        <Button Name="LivingButton" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,0" Click="Living_Click" ToolTip="Living mode: your personas think on their own while you're away, and keep a journal">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEB51;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Name="LivingButtonText" Text="Living mode" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="PicturesButton" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,0" Click="Pictures_Click" ToolTip="Pictures: let Vicki and Aquila draw pictures">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Pictures" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="SoundboardButton" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,0" Click="Soundboard_Click" ToolTip="Soundboard: sounds your personas can play">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE8D6;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Soundboard" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <Button Name="ScenesButton" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,0" Click="Scenes_Click" ToolTip="Scenes: several personas together in one shared scene">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE716;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Scenes" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Companion mode -->
        <Button Name="CompanionButton" DockPanel.Dock="Bottom" Style="{StaticResource Btn.Ghost}" HorizontalContentAlignment="Left" Margin="0,0,0,4" Padding="10,0" Click="Companion_Click" ToolTip="Companions: personas with their own drives and memory">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="&#xE77B;" FontFamily="{StaticResource Font.Icon}" FontSize="14" VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Text="Companions" VerticalAlignment="Center" />
          </StackPanel>
        </Button>
        <!-- Avatar -->
        <Border Name="AvatarPanel" DockPanel.Dock="Bottom" Style="{StaticResource Card}" Padding="8" Margin="0,12,0,8">
          <Grid>
            <ContentControl Name="AvatarSlot" Height="184" />
            <TextBlock Name="AvatarPoppedText" Text="Floating on your desktop. Double-click it to bring it back." Visibility="Collapsed" Style="{StaticResource Type.Small}" TextAlignment="Center" Margin="8,14,40,14" VerticalAlignment="Center" />
            <Button Name="AvatarPopButton" Style="{StaticResource Btn.Icon}" HorizontalAlignment="Right" VerticalAlignment="Top" Background="#99121A23" ToolTip="Float the avatar on your desktop" Click="AvatarPop_Click" Content="&#xE8A7;" />
          </Grid>
        </Border>
        <!-- Chats fill the rest -->
        <ListBox Name="ChatsList" AutomationProperties.Name="Saved conversations" SelectionChanged="Chats_Changed">
          <UIElement.InputBindings>
            <KeyBinding Key="Delete" Command="{x:Static local:MainWindow.DeleteChatCommand}" />
          </UIElement.InputBindings>
          <ItemsControl.ItemContainerStyle>
            <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="{x:Type ListBoxItem}">
              <Setter Property="ContextMenu">
                <Setter.Value>
                  <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                    <MenuItem Header="Delete chat…" Foreground="{StaticResource Danger}" Command="{x:Static local:MainWindow.DeleteChatCommand}" CommandParameter="{Binding}" CommandTarget="{Binding PlacementTarget, RelativeSource={RelativeSource AncestorType={x:Type ContextMenu}}}">
                      <MenuItem.Icon>
                        <TextBlock Text="&#xE74D;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Foreground="{StaticResource Danger}" />
                      </MenuItem.Icon>
                    </MenuItem>
                  </ContextMenu>
                </Setter.Value>
              </Setter>
              <EventSetter Event="PreviewMouseRightButtonDown" Handler="Chat_RightClick" />
            </Style>
          </ItemsControl.ItemContainerStyle>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Grid x:Name="Row" Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="RowTitle" TextTrimming="CharacterEllipsis" FontSize="14" FontWeight="Medium" Foreground="{StaticResource Text.Secondary}" Text="{Binding Title}" />
                  <TextBlock Style="{StaticResource Type.Caption}" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Text="{Binding Subtitle}" />
                </StackPanel>
                <Button x:Name="RowDelete" Grid.Column="1" Style="{StaticResource Btn.IconDanger}" Width="28" Height="28" FontSize="13" Content="&#xE74D;" ToolTip="Delete chat" Visibility="Hidden" Command="{x:Static local:MainWindow.DeleteChatCommand}" CommandParameter="{Binding}" />
              </Grid>
              <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                  <Setter TargetName="RowDelete" Property="Visibility" Value="Visible" />
                  <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource Text.Primary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType={x:Type ListBoxItem}}}" Value="True">
                  <Setter TargetName="RowTitle" Property="Foreground" Value="{StaticResource Text.Primary}" />
                </DataTrigger>
              </DataTemplate.Triggers>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- ================= Conversation ================= -->
    <Grid Grid.Column="1">
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <!-- Header -->
      <Border BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,0,1" Padding="24,0,16,0">
        <DockPanel>
          <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Name="VoiceReplayButton" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Content="&#xE767;" ToolTip="Read the last reply aloud" Click="ReplayVoice_Click" />
            <Button Name="VoiceStopButton" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Margin="4,0,0,0" ToolTip="Stop speaking" Click="StopVoice_Click" Visibility="{Binding IsEnabled, RelativeSource={RelativeSource Self}, Converter={StaticResource BoolToVisibility}}" >
              <Border Width="10" Height="10" CornerRadius="2" Background="{StaticResource Text.Secondary}" />
            </Button>
            <Button Name="MoreButton" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Margin="4,0,0,0" Content="&#xE712;" ToolTip="More options" ToolTipService.Placement="Left" Click="More_Click" />
            <Button Name="SettingsButton" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Margin="4,0,0,0" Content="&#xE713;" ToolTip="Settings (Ctrl+,)" Click="Settings_Click" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center" ClipToBounds="True">
            <Ellipse Name="ChatAvatar" Width="28" Height="28" Margin="0,0,10,0" VerticalAlignment="Center" Visibility="Collapsed" />
            <TextBlock Name="ChatTitle" Text="New conversation" Style="{StaticResource Type.Subtitle}" TextTrimming="CharacterEllipsis" MaxWidth="340" VerticalAlignment="Center" />
            <Button Name="LocationChip" Style="{StaticResource Btn.HeaderChip}" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="Location_Click" ToolTip="Where you are in the story. Click to change it; she can move it too.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE707;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Name="LocationChipText" Text="Where are we?" TextTrimming="CharacterEllipsis" MaxWidth="240" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Border Name="StatusChip" Style="{StaticResource Chip}" Margin="12,0,0,0" VerticalAlignment="Center">
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Name="StatusDot" Width="8" Height="8" Fill="{StaticResource Text.Tertiary}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <TextBlock Name="StatusText" Text="No model loaded" FontSize="12" Foreground="{StaticResource Text.Secondary}" MaxWidth="260" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
              </StackPanel>
            </Border>
            <Button Name="ModelChip" Style="{StaticResource Btn.HeaderChip}" Margin="8,0,0,0" VerticalAlignment="Center" Click="ModelChip_Click">
              <TextBlock Name="ModelChipText" Text="No model" TextTrimming="CharacterEllipsis" MaxWidth="170" />
            </Button>
            <Button Name="WebChip" Style="{StaticResource Btn.HeaderChip}" Margin="8,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" Click="Internet_Click" ToolTip="Aquila may contact the internet. Click to change.">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE774;" FontFamily="{StaticResource Font.Icon}" FontSize="12" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Name="WebChipText" Text="Web: ask first" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </StackPanel>
        </DockPanel>
      </Border>
      <Popup Name="MoreMenu" PlacementTarget="{Binding ElementName=MoreButton}" Placement="Bottom" HorizontalOffset="-260" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
        <Border Style="{StaticResource Popup.Surface}" Width="280">
          <StackPanel>
            <Button Style="{StaticResource Btn.Menu}" Click="Export_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xEDE1;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="Export chat" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="CompactButton" Style="{StaticResource Btn.Menu}" ToolTip="Summarise earlier turns so a long chat can keep going. The full history you see is kept." Click="Compact_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8C6;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="Shorten this conversation…" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Button Name="SummaryButton" Style="{StaticResource Btn.Menu}" Visibility="Collapsed" Click="Summary_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8A5;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="View summary…" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Style="{StaticResource Divider}" Margin="8,4" />
            <Button Style="{StaticResource Btn.Menu}" Click="Data_Click">
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xE8B7;" FontFamily="{StaticResource Font.Icon}" FontSize="14" Width="28" VerticalAlignment="Center" />
                <TextBlock Text="Open data folder" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <Rectangle Style="{StaticResource Divider}" Margin="8,4" />
            <StackPanel Margin="10,6,10,8">
              <TextBlock Name="SessionUsageText" Text="Session · 0 tokens" Style="{StaticResource Type.Caption}" TextWrapping="Wrap" ToolTip="Cumulative input and output across this conversation." />
              <TextBlock Name="MetricsText" Style="{StaticResource Type.Caption}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
          </StackPanel>
        </Border>
      </Popup>

      <!-- Messages -->
      <ScrollViewer Name="ChatScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,24,14,8" ScrollChanged="Chat_ScrollChanged">
        <Grid>
          <StackPanel Name="Messages" MaxWidth="820" HorizontalAlignment="Stretch" />
          <StackPanel Name="Welcome" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="640" Margin="0,48,0,40">
            <Border Width="56" Height="56" CornerRadius="16" Background="{StaticResource Accent.Subtle}" HorizontalAlignment="Center">
              <TextBlock Text="A" Foreground="{StaticResource Accent}" FontSize="28" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Name="WelcomeNoModel">
              <TextBlock Text="Welcome to Aquila" Style="{StaticResource Type.Display}" HorizontalAlignment="Center" Margin="0,20,0,8" />
              <TextBlock Text="Your private assistant. It runs on this computer, and nothing you type leaves it." Style="{StaticResource Type.Body}" Foreground="{StaticResource Text.Secondary}" TextAlignment="Center" TextWrapping="Wrap" />
              <Button Name="WelcomeLoadButton" Style="{StaticResource Btn.Large}" Width="220" Margin="0,24,0,0" HorizontalAlignment="Center" Content="Start Aquila" Click="WelcomeLoad_Click" />
              <TextBlock Name="WelcomeLoadHint" Style="{StaticResource Type.Caption}" TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" Text="This can take a minute the first time." />
            </StackPanel>
            <StackPanel Name="WelcomeReady" Visibility="Collapsed">
              <TextBlock Text="What can I help with?" Style="{StaticResource Type.Display}" HorizontalAlignment="Center" Margin="0,20,0,24" />
              <WrapPanel HorizontalAlignment="Center">
                <Button Style="{StaticResource Btn.Chip}" Margin="4" Content="Explain something simply" Tag="Explain this to me in simple terms: " Click="Starter_Click" />
                <Button Style="{StaticResource Btn.Chip}" Margin="4" Content="Help me write a message" Tag="Help me write a message to " Click="Starter_Click" />
                <Button Style="{StaticResource Btn.Chip}" Margin="4" Content="Plan my week" Tag="Help me plan my week. Here is what I need to do: " Click="Starter_Click" />
              </WrapPanel>
            </StackPanel>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <!-- Notice -->
      <Border Name="NoticeBox" Grid.Row="2" MaxWidth="820" Background="{StaticResource Warning.Subtle}" BorderBrush="{StaticResource Warning.SubtleStroke}" BorderThickness="1" CornerRadius="12" Margin="24,0,24,8" Padding="14,10,6,10" Visibility="Collapsed">
        <DockPanel>
          <TextBlock DockPanel.Dock="Left" Text="&#xE7BA;" FontFamily="{StaticResource Font.Icon}" FontSize="16" Foreground="{StaticResource Warning}" VerticalAlignment="Top" Margin="0,1,10,0" />
          <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Width="28" Height="28" FontSize="12" Content="&#xE711;" ToolTip="Dismiss" VerticalAlignment="Top" Click="Dismiss_Click" />
          <ScrollViewer MaxHeight="110" VerticalScrollBarVisibility="Auto">
            <TextBlock Name="NoticeText" Style="{StaticResource Type.Small}" Foreground="{StaticResource Warning.Ink}" VerticalAlignment="Center" />
          </ScrollViewer>
        </DockPanel>
      </Border>

      <!-- Composer -->
      <StackPanel Grid.Row="3" Margin="24,4,24,16" MaxWidth="820">
        <WrapPanel Name="AttachmentChips" Margin="0,0,0,8" />
        <Grid>
          <Border Name="ComposerCard" Background="{StaticResource Surface.1}" BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1" CornerRadius="16" />
          <Border Name="ComposerFocus" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="16" Opacity="0" IsHitTestVisible="False" />
          <Grid Margin="14,10,10,10">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="36" />
            </Grid.RowDefinitions>
            <local:MarkupComposer x:Name="Composer" local:Ui.Placeholder="Message Aquila…" AutomationProperties.Name="Message" FontSize="15" MinHeight="44" MaxHeight="200" Padding="2,4" PreviewKeyDown="Composer_KeyDown" TextChanged="Composer_TextChanged" GotKeyboardFocus="Composer_FocusChanged" LostKeyboardFocus="Composer_FocusChanged" />
            <Button Name="AttachButton" Grid.Row="1" Style="{StaticResource Btn.Icon}" Width="36" Height="36" HorizontalAlignment="Left" Content="&#xE723;" ToolTip="Attach files" Click="Attach_Click" />
            <Button Name="MicButton" Grid.Row="1" Style="{StaticResource Btn.Icon}" Width="36" Height="36" Margin="40,0,0,0" HorizontalAlignment="Left" Content="&#xE720;" ToolTip="Talk instead of typing (right-click for settings)" Click="Mic_Click" ContextMenuOpening="Mic_ContextMenuOpening">
              <Button.ContextMenu>
                <ContextMenu />
              </Button.ContextMenu>
            </Button>
            <local:MarkupToggles x:Name="MarkupBar" Grid.Row="1" Margin="84,0,0,0" HorizontalAlignment="Left" />
            <Grid Grid.Row="1" HorizontalAlignment="Right">
              <Button Name="SendButton" Style="{StaticResource Btn.Primary}" local:Ui.Radius="18" Width="36" Height="36" MinHeight="0" Padding="0" ToolTip="Send (Enter)" Click="Send_Click" IsEnabled="False" RenderTransformOrigin="0.5,0.5">
                <TextBlock Text="&#xE74A;" FontFamily="{StaticResource Font.Icon}" FontSize="16" />
              </Button>
              <Button Name="StopButton" Style="{StaticResource Btn.Secondary}" local:Ui.Radius="18" Width="36" Height="36" MinHeight="0" Padding="0" Background="{StaticResource Surface.3}" BorderBrush="{StaticResource Stroke.Strong}" ToolTip="Stop" Visibility="Collapsed" Click="Stop_Click">
                <Border Width="12" Height="12" CornerRadius="3" Background="{StaticResource Text.Primary}" />
              </Button>
            </Grid>
          </Grid>
        </Grid>
        <TextBlock Name="ComposerHint" Style="{StaticResource Type.Caption}" Margin="4,6,4,0" Text="Enter to send · Shift+Enter for a new line · Drop files to attach" />
      </StackPanel>
    </Grid>

    <!-- ================= Settings drawer ================= -->
    <Border Name="DrawerScrim" Grid.ColumnSpan="2" Background="{StaticResource Scrim}" Visibility="Collapsed" Opacity="0" MouseLeftButtonDown="DrawerScrim_Click" />
    <Border Name="SettingsDrawer" Grid.ColumnSpan="2" Width="420" HorizontalAlignment="Right" Visibility="Collapsed" Background="{StaticResource Bg.Sidebar}" BorderBrush="{StaticResource Stroke.Default}" BorderThickness="1,1,0,0" Effect="{StaticResource Shadow.Drawer}">
      <Border.RenderTransform>
        <TranslateTransform x:Name="DrawerShift" X="420" />
      </Border.RenderTransform>
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="64" Padding="20,0,12,0" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,0,0,1">
          <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn.Icon}" Content="&#xE711;" FontSize="13" ToolTip="Close (Esc)" VerticalAlignment="Center" Click="CloseDrawer_Click" />
            <TextBlock Text="Settings" Style="{StaticResource Type.Subtitle}" VerticalAlignment="Center" />
          </DockPanel>
        </Border>
        <Border DockPanel.Dock="Top" Margin="20,16,20,0" Background="{StaticResource Surface.1}" CornerRadius="8" Padding="3">
          <UniformGrid Columns="3">
            <RadioButton Name="TabGeneral" GroupName="SettingsTabs" Style="{StaticResource SegmentedTab}" Content="General" IsChecked="True" Checked="SettingsTab_Checked" />
            <RadioButton Name="TabModel" GroupName="SettingsTabs" Style="{StaticResource SegmentedTab}" Content="Model" Checked="SettingsTab_Checked" />
            <RadioButton Name="TabAdvanced" GroupName="SettingsTabs" Style="{StaticResource SegmentedTab}" Content="Advanced" Checked="SettingsTab_Checked" />
          </UniformGrid>
        </Border>
        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface.1}" BorderBrush="{StaticResource Stroke.Subtle}" BorderThickness="0,1,0,0" Padding="20,12">
          <Button Name="SaveSettingsButton" Style="{StaticResource Btn.Primary}" HorizontalAlignment="Stretch" Content="Save settings" Click="SaveSettings_Click" />
        </Border>
        <ScrollViewer Name="DrawerScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Name="SetupControls" Margin="20,16,10,24">

            <!-- ======== General ======== -->
            <StackPanel Name="GeneralPanel">
              <TextBlock Text="Personality" Style="{StaticResource Type.Label}" Margin="0,8,0,8" />
              <ComboBox Name="PersonalityCombo" AutomationProperties.Name="Active personality" DisplayMemberPath="Name" SelectionChanged="Personality_Changed" />
              <TextBlock Name="PersonalitySummary" Style="{StaticResource Type.Small}" Margin="0,8,0,0" />
              <Button Content="Manage personalities…" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Personalities_Click" />

              <TextBlock Text="Things to always remember" Style="{StaticResource Type.Label}" />
              <TextBox Name="MemoryBox" AutomationProperties.Name="Persistent memory" local:Ui.Placeholder="For example: my name is Sam, I prefer metric units." AcceptsReturn="True" TextWrapping="Wrap" Height="96" VerticalScrollBarVisibility="Auto" MaxLength="16000" />
              <TextBlock Text="Included in every conversation." Style="{StaticResource Type.Small}" Margin="0,6,0,0" />

              <TextBlock Text="Memory" Style="{StaticResource Type.Label}" />
              <TextBlock Text="Aquila can pick up facts as you chat. You can review and delete them at any time." Style="{StaticResource Type.Small}" Margin="0,0,0,4" />
              <CheckBox Name="LearnMemoryCheck" Style="{StaticResource Switch}" Content="Learn from our conversations" />
              <CheckBox Name="UseMemoryCheck" Style="{StaticResource Switch}" Content="Use what you remember" />
              <Button Content="Review memories…" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" Click="Memories_Click" />

              <TextBlock Text="Your files" Style="{StaticResource Type.Label}" />
              <TextBlock Text="Aquila only looks inside the folder you choose." Style="{StaticResource Type.Small}" Margin="0,0,0,8" />
              <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                  <TextBlock Name="WorkspaceName" Text="No folder selected" Style="{StaticResource Type.Small}" Foreground="{StaticResource Text.Primary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                  <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button Content="Choose folder…" Click="Workspace_Click" />
                    <Button Content="Clear" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0" Click="ClearWorkspace_Click" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <CheckBox Name="ToolsCheck" Style="{StaticResource Switch}" Content="Let Aquila read files in this folder" IsChecked="True" Margin="0,8,0,0" />

              <TextBlock Text="Replies" Style="{StaticResource Type.Label}" />
              <CheckBox Name="ThinkingCheck" Style="{StaticResource Switch}" Content="Think before answering" local:Ui.Hint="Slower, often better for hard questions." Checked="Reasoning_Changed" Unchecked="Reasoning_Changed" />
              <CheckBox Name="ReplyEmojiCheck" Style="{StaticResource Switch}" Content="Use the occasional emoji" />

              <TextBlock Text="Sounds" Style="{StaticResource Type.Label}" />
              <CheckBox Name="UiSoundsCheck" Style="{StaticResource Switch}" Content="Interface sounds" local:Ui.Hint="Soft tones when you send, when a reply is ready and when the model has loaded." Checked="UiSounds_Changed" Unchecked="UiSounds_Changed" />
              <StackPanel Name="UiSoundVolumePanel" Margin="0,8,0,0">
                <Slider Name="UiSoundVolumeSlider" AutomationProperties.Name="Sound volume" Minimum="0" Maximum="1" Value="0.5" PreviewMouseLeftButtonUp="UiSoundVolume_Released" ValueChanged="UiSoundVolume_Changed" />
                <DockPanel Margin="0,2,0,0">
                  <TextBlock DockPanel.Dock="Right" Text="Louder" Style="{StaticResource Type.Caption}" />
                  <TextBlock Text="Quieter" Style="{StaticResource Type.Caption}" />
                </DockPanel>
              </StackPanel>
            </StackPanel>

            <!-- ======== Model ======== -->
            <StackPanel Name="ModelPanel" Visibility="Collapsed">
              <TextBlock Text="Model" Style="{StaticResource Type.Label}" Margin="0,8,0,8" />
              <ComboBox Name="InstalledModelsCombo" AutomationProperties.Name="Installed models" DisplayMemberPath="Name" SelectionChanged="InstalledModels_Changed" />
              <TextBlock Name="ModelName" Text="No model selected" Style="{StaticResource Type.Caption}" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis" Margin="0,6,0,0" />
              <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition />
                  <ColumnDefinition Width="8" />
                  <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Name="LoadButton" Style="{StaticResource Btn.Secondary}" Content="Load model" Click="Load_Click" />
                <Button Name="UnloadButton" Grid.Column="2" Content="Unload" Click="Unload_Click" />
              </Grid>
              <Button Content="Add a model file…" Style="{StaticResource Btn.Link}" HorizontalAlignment="Left" Margin="0,8,0,0" ToolTip="Choose a .gguf model file from your computer." Click="Model_Click" />

              <TextBlock Text="Speed" Style="{StaticResource Type.Label}" />
              <ComboBox Name="ProfileCombo" AutomationProperties.Name="Inference profile" SelectedValuePath="Tag" SelectionChanged="Profile_Changed">
                <ComboBoxItem Tag="Auto" Content="Automatic (recommended)" />
                <ComboBoxItem Tag="High" Content="Manual: large graphics card" />
                <ComboBoxItem Tag="Laptop" Content="Manual: small laptop" />
                <ComboBoxItem Tag="Custom" Content="Manual: custom (expert)" />
              </ComboBox>
              <TextBlock Name="HardwareText" Text="Detecting hardware…" Style="{StaticResource Type.Small}" Margin="0,8,0,0" />

              <TextBlock Text="Conversation length" Style="{StaticResource Type.Label}" />
              <DockPanel>
                <TextBlock Name="ContextValue" DockPanel.Dock="Right" Text="8,192 tokens" Style="{StaticResource Type.BodyStrong}" />
                <TextBlock Text="How much Aquila can keep in mind" Style="{StaticResource Type.Small}" VerticalAlignment="Center" />
              </DockPanel>
              <Slider Name="ContextSlider" AutomationProperties.Name="Allowed context" Style="{StaticResource ContextSliderStyle}" Minimum="11" Maximum="18" Value="13" TickFrequency="0.25" IsSnapToTickEnabled="False" IsMoveToPointEnabled="False" Margin="0,8,0,0" ValueChanged="ContextSlider_Changed" />
              <Canvas Name="ThresholdCanvas" Height="16" Margin="2,0" SizeChanged="Thresholds_SizeChanged">
                <Border Name="ProfileTargetMarker" Width="12" Height="14" Background="Transparent" ToolTip="Recommended for this computer">
                  <Border Width="2" Background="{StaticResource ContextTargetInk}" />
                </Border>
                <Border Name="MemoryEstimateMarker" Width="12" Height="14" Background="Transparent" ToolTip="{Binding ElementName=ContextRisk, Path=ToolTip}">
                  <Border Name="MemoryEstimateLine" Width="2" Background="{StaticResource ContextAdvisoryInk}" />
                </Border>
              </Canvas>
              <TextBlock Name="ContextThresholds" Text="Reading model details…" Style="{StaticResource Type.Small}" TextWrapping="Wrap" />
              <TextBlock Name="ContextRisk" Style="{StaticResource Type.Small}" Margin="0,6,0,0" />

              <TextBlock Text="Graphics card activity" Style="{StaticResource Type.Label}" />
              <Border Style="{StaticResource Card}" Padding="12">
                <StackPanel>
                  <ComboBox Name="GpuAdapterCombo" AutomationProperties.Name="GPU to monitor" DisplayMemberPath="Name" SelectionChanged="GpuAdapter_Changed" />
                  <TextBlock Name="GpuSummary" Text="Starting Windows counters…" Style="{StaticResource Type.Small}" Margin="0,8,0,8" />
                  <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="44" />
                      <ColumnDefinition Width="64" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="App" Style="{StaticResource Type.Caption}" />
                    <TextBlock Text="Busy" Grid.Column="1" Style="{StaticResource Type.Caption}" TextAlignment="Right" />
                    <TextBlock Text="Memory" Grid.Column="2" Style="{StaticResource Type.Caption}" TextAlignment="Right" />
                  </Grid>
                  <ScrollViewer MaxHeight="120" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl Name="GpuAppsList">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,3">
                            <Grid.ToolTip>
                              <TextBlock Text="{Binding Pids}" />
                            </Grid.ToolTip>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition />
                              <ColumnDefinition Width="44" />
                              <ColumnDefinition Width="64" />
                            </Grid.ColumnDefinitions>
                            <TextBlock FontSize="12" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding Name}" />
                            <TextBlock Grid.Column="1" FontSize="12" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Text="{Binding UsageLabel}" />
                            <TextBlock Grid.Column="2" FontSize="12" TextAlignment="Right" Typography.NumeralAlignment="Tabular" Text="{Binding MemoryLabel}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                  <TextBlock Name="GpuFootnote" Text="Every 2 seconds · busiest engine per app" Style="{StaticResource Type.Caption}" TextWrapping="Wrap" Margin="0,8,0,0" ToolTip="Windows graphics counters. App percentage is the busiest engine after grouping same-name processes. Percentages and memory are not additive." />
                </StackPanel>
              </Border>
            </StackPanel>

            <!-- ======== Advanced ======== -->
            <StackPanel Name="AdvancedPanel" Visibility="Collapsed">
              <TextBlock Text="You do not need to change anything here. The defaults are chosen for your computer." Style="{StaticResource Type.Small}" Margin="0,8,0,16" />

              <Expander Style="{StaticResource Expander.Card}" Header="Instructions">
                <StackPanel>
                  <TextBlock Text="Extra instructions included with every message." Style="{StaticResource Type.Small}" Margin="0,0,0,8" />
                  <TextBox Name="InstructionsBox" AutomationProperties.Name="System instructions" Height="160" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" MaxLength="16000" />
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Reply length and thinking">
                <StackPanel>
                  <DockPanel Margin="0,4,0,0">
                    <TextBox Name="MaxTokensBox" DockPanel.Dock="Right" Width="120" AutomationProperties.Name="Response limit" TextChanged="Reasoning_Changed" />
                    <TextBlock Text="Longest reply (tokens)" VerticalAlignment="Center" />
                  </DockPanel>
                  <DockPanel Margin="0,8,0,0">
                    <TextBox Name="ThinkingBudgetBox" DockPanel.Dock="Right" Width="120" AutomationProperties.Name="Thinking budget" TextChanged="Reasoning_Changed" />
                    <TextBlock Text="Thinking budget (tokens)" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Name="ThinkingSummary" Style="{StaticResource Type.Small}" Margin="0,8,0,0" />
                  <TextBlock Text="Thinking shares the reply limit. Part of it is reserved for the final answer. More thinking takes longer and does not always help." Style="{StaticResource Type.Small}" Margin="0,6,0,0" />
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Creativity">
                <StackPanel>
                  <DockPanel Margin="0,4,0,0">
                    <TextBox Name="TempBox" DockPanel.Dock="Right" Width="120" AutomationProperties.Name="Temperature" />
                    <TextBlock Text="Temperature (0–2)" VerticalAlignment="Center" />
                  </DockPanel>
                  <CheckBox Name="CreativeCheck" Style="{StaticResource Switch}" Content="Creative writing samplers" Checked="Creative_Changed" Unchecked="Creative_Changed" Margin="0,8,0,0" />
                  <Grid Name="CreativeControls" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition />
                      <ColumnDefinition Width="12" />
                      <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                      <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Grid.Column="0">
                      <TextBlock Text="Creative temperature" Style="{StaticResource Label}" Margin="0,4,0,6" />
                      <TextBox Name="CreativeTempBox" AutomationProperties.Name="Creative temperature" />
                    </StackPanel>
                    <StackPanel Grid.Row="0" Grid.Column="2">
                      <TextBlock Text="Min-p (0–1)" Style="{StaticResource Label}" Margin="0,4,0,6" />
                      <TextBox Name="MinPBox" AutomationProperties.Name="Min-p" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="0">
                      <TextBlock Text="Top-p (1 = off)" Style="{StaticResource Label}" Margin="0,12,0,6" />
                      <TextBox Name="TopPBox" AutomationProperties.Name="Top-p" />
                    </StackPanel>
                    <StackPanel Grid.Row="1" Grid.Column="2">
                      <TextBlock Text="DRY multiplier (0 = off)" Style="{StaticResource Label}" Margin="0,12,0,6" />
                      <TextBox Name="DryMultiplierBox" AutomationProperties.Name="DRY multiplier" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="0">
                      <TextBlock Text="DRY base" Style="{StaticResource Label}" Margin="0,12,0,6" />
                      <TextBox Name="DryBaseBox" AutomationProperties.Name="DRY base" />
                    </StackPanel>
                    <StackPanel Grid.Row="2" Grid.Column="2">
                      <TextBlock Text="DRY allowed repeat" Style="{StaticResource Label}" Margin="0,12,0,6" />
                      <TextBox Name="DryLengthBox" AutomationProperties.Name="DRY allowed length" />
                    </StackPanel>
                  </Grid>
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Hardware">
                <StackPanel>
                  <TextBlock Text="Exact conversation length (tokens)" Style="{StaticResource Label}" Margin="0,4,0,6" />
                  <ComboBox Name="ContextCombo" AutomationProperties.Name="Context window" SelectionChanged="ContextCombo_Changed">
                    <ComboBoxItem Content="2048" />
                    <ComboBoxItem Content="4096" />
                    <ComboBoxItem Content="8192" />
                    <ComboBoxItem Content="16384" />
                    <ComboBoxItem Content="24576" />
                    <ComboBoxItem Content="32768" />
                    <ComboBoxItem Content="65536" />
                    <ComboBoxItem Content="131072" />
                    <ComboBoxItem Content="262144" />
                  </ComboBox>
                  <CheckBox Name="LaptopQ4Check" Content="Use 4-bit KV cache (experimental)" ToolTip="Uses less cache memory. Switch back to 8-bit if replies become repetitive or incoherent." Checked="Cache_Changed" Unchecked="Cache_Changed" Margin="0,12,0,0" />
                  <StackPanel Name="CustomCachePanel">
                    <TextBlock Text="Custom KV cache" Style="{StaticResource Label}" />
                    <ComboBox Name="CustomCacheCombo" AutomationProperties.Name="Custom KV cache" SelectedValuePath="Content" SelectionChanged="Cache_Changed">
                      <ComboBoxItem Content="f16" />
                      <ComboBoxItem Content="q8_0" />
                      <ComboBoxItem Content="q4_0" />
                    </ComboBox>
                  </StackPanel>
                  <TextBlock Name="ExpertsLabel" Text="MoE expert layers on CPU (0 = off)" Style="{StaticResource Label}" />
                  <TextBox Name="ExpertLayersBox" AutomationProperties.Name="MoE expert layers on CPU" TextChanged="Compute_Changed" />
                  <TextBlock Name="ExpertsHint" Style="{StaticResource Type.Small}" Margin="0,6,0,0" />
                  <DockPanel Margin="0,12,0,0">
                    <TextBox Name="GpuBox" DockPanel.Dock="Right" Width="120" AutomationProperties.Name="GPU layers" TextChanged="Compute_Changed" />
                    <TextBlock Text="GPU layers (Custom: -1 auto, 0 CPU only)" Style="{StaticResource Type.Small}" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" Margin="0,0,12,0" />
                  </DockPanel>
                  <DockPanel Margin="0,8,0,0">
                    <TextBox Name="CpuBox" DockPanel.Dock="Right" Width="120" AutomationProperties.Name="CPU threads" />
                    <TextBlock Text="CPU threads (0 = automatic)" Style="{StaticResource Type.Small}" Foreground="{StaticResource Text.Primary}" VerticalAlignment="Center" />
                  </DockPanel>
                  <TextBlock Text="Automatic mode keeps some video memory free. Use fewer GPU layers if other apps need the graphics card." Style="{StaticResource Type.Small}" Margin="0,8,0,0" />
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Pictures (vision)">
                <StackPanel>
                  <TextBlock Name="VisionStatus" Text="Vision: no projector selected" Style="{StaticResource Type.Small}" Margin="0,4,0,8" />
                  <StackPanel Orientation="Horizontal">
                    <Button Content="Choose vision projector…" Click="Projector_Click" />
                    <Button Content="Clear" Style="{StaticResource Btn.Ghost}" Margin="8,0,0,0" Click="ClearProjector_Click" />
                  </StackPanel>
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Memory and files">
                <StackPanel>
                  <CheckBox Name="SemanticMemoryCheck" Style="{StaticResource Switch}" Content="Match memories by meaning" local:Ui.Hint="Uses a small model on the processor (MiniLM). Falls back to keywords." />
                  <CheckBox Name="LookupCheck" Style="{StaticResource Switch}" Content="Require a file lookup each message" />
                </StackPanel>
              </Expander>

              <Expander Style="{StaticResource Expander.Card}" Header="Diagnostics">
                <StackPanel>
                  <CheckBox Name="ShowDetailsCheck" Style="{StaticResource Switch}" Content="Show technical details in chat" local:Ui.Hint="Speed, token counts and tool activity under every reply." />
                  <Button Content="Open data folder" Style="{StaticResource Btn.Ghost}" HorizontalAlignment="Left" Margin="-14,8,0,0" Click="Data_Click" />
                  <TextBlock Text="Aquila Local 2.1" Style="{StaticResource Type.Caption}" Margin="0,8,0,0" />
                </StackPanel>
              </Expander>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </DockPanel>
    </Border>
  </Grid>
</local:AquilaWindow>
