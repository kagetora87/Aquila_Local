<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime">
  <!-- Aquila design tokens. "Night sky, one star": near-black blue ink, one aquamarine accent. -->
  <Color x:Key="C.Bg.Window">#0B0F14</Color>
  <Color x:Key="C.Bg.Sidebar">#0E141B</Color>
  <Color x:Key="C.Surface.1">#121A23</Color>
  <Color x:Key="C.Surface.2">#18222D</Color>
  <Color x:Key="C.Surface.3">#1F2B38</Color>
  <Color x:Key="C.Surface.Code">#070A0E</Color>
  <Color x:Key="C.Overlay.Hover">#FFFFFF</Color>
  <Color x:Key="C.Overlay.Press">#000000</Color>
  <Color x:Key="C.Scrim">#99050709</Color>
  <Color x:Key="C.Stroke.Subtle">#1E2936</Color>
  <Color x:Key="C.Stroke.Default">#2A3847</Color>
  <Color x:Key="C.Stroke.Strong">#3B4C5F</Color>
  <Color x:Key="C.Text.Primary">#E8EDF3</Color>
  <Color x:Key="C.Text.Secondary">#A7B4C2</Color>
  <Color x:Key="C.Text.Tertiary">#7C8A99</Color>
  <Color x:Key="C.Text.Disabled">#566373</Color>
  <Color x:Key="C.Accent">#74E0C6</Color>
  <Color x:Key="C.Accent.Hover">#8DE9D2</Color>
  <Color x:Key="C.Accent.Pressed">#5BC9AF</Color>
  <Color x:Key="C.Accent.On">#06211C</Color>
  <Color x:Key="C.Accent.Subtle">#14302D</Color>
  <Color x:Key="C.Accent.SubtleStroke">#245149</Color>
  <Color x:Key="C.Danger">#F2777A</Color>
  <Color x:Key="C.Danger.Solid">#D9575B</Color>
  <Color x:Key="C.Danger.On">#FFFFFF</Color>
  <Color x:Key="C.Danger.Subtle">#3A1D21</Color>
  <Color x:Key="C.Danger.SubtleStroke">#6B2F35</Color>
  <Color x:Key="C.Warning">#F1C27D</Color>
  <Color x:Key="C.Warning.Subtle">#33281A</Color>
  <Color x:Key="C.Warning.SubtleStroke">#5E4A2B</Color>
  <Color x:Key="C.Warning.Ink">#F4DDB6</Color>
  <Color x:Key="C.Info">#8FB8F2</Color>
  <Color x:Key="C.Focus">#74E0C6</Color>
  <Color x:Key="C.Selection">#2F6A60</Color>
  <Color x:Key="C.Hover.Fill">#0FFFFFFF</Color>
  <Color x:Key="C.Syn.Keyword">#C4A7F5</Color>
  <Color x:Key="C.Syn.String">#A8DDA0</Color>
  <Color x:Key="C.Syn.Number">#F1C27D</Color>
  <Color x:Key="C.Syn.Comment">#6F7E8E</Color>
  <Color x:Key="C.Syn.Function">#8FB8F2</Color>
  <Color x:Key="C.Syn.Type">#74E0C6</Color>
  <Color x:Key="C.Syn.Plain">#D7DEE7</Color>
  <Color x:Key="C.Code.Inline">#B9EBDD</Color>
  <SolidColorBrush x:Key="Bg.Window" Color="#0B0F14" />
  <SolidColorBrush x:Key="Bg.Sidebar" Color="#0E141B" />
  <SolidColorBrush x:Key="Surface.1" Color="#121A23" />
  <SolidColorBrush x:Key="Surface.2" Color="#18222D" />
  <SolidColorBrush x:Key="Surface.3" Color="#1F2B38" />
  <SolidColorBrush x:Key="Surface.Code" Color="#070A0E" />
  <SolidColorBrush x:Key="Overlay.Hover" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Overlay.Press" Color="#000000" />
  <SolidColorBrush x:Key="Scrim" Color="#99050709" />
  <SolidColorBrush x:Key="Stroke.Subtle" Color="#1E2936" />
  <SolidColorBrush x:Key="Stroke.Default" Color="#2A3847" />
  <SolidColorBrush x:Key="Stroke.Strong" Color="#3B4C5F" />
  <SolidColorBrush x:Key="Text.Primary" Color="#E8EDF3" />
  <SolidColorBrush x:Key="Text.Secondary" Color="#A7B4C2" />
  <SolidColorBrush x:Key="Text.Tertiary" Color="#7C8A99" />
  <SolidColorBrush x:Key="Text.Disabled" Color="#566373" />
  <SolidColorBrush x:Key="Accent" Color="#74E0C6" />
  <SolidColorBrush x:Key="Accent.Hover" Color="#8DE9D2" />
  <SolidColorBrush x:Key="Accent.Pressed" Color="#5BC9AF" />
  <SolidColorBrush x:Key="Accent.On" Color="#06211C" />
  <SolidColorBrush x:Key="Accent.Subtle" Color="#14302D" />
  <SolidColorBrush x:Key="Accent.SubtleStroke" Color="#245149" />
  <SolidColorBrush x:Key="Danger" Color="#F2777A" />
  <SolidColorBrush x:Key="Danger.Solid" Color="#D9575B" />
  <SolidColorBrush x:Key="Danger.On" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Danger.Subtle" Color="#3A1D21" />
  <SolidColorBrush x:Key="Danger.SubtleStroke" Color="#6B2F35" />
  <SolidColorBrush x:Key="Warning" Color="#F1C27D" />
  <SolidColorBrush x:Key="Warning.Subtle" Color="#33281A" />
  <SolidColorBrush x:Key="Warning.SubtleStroke" Color="#5E4A2B" />
  <SolidColorBrush x:Key="Warning.Ink" Color="#F4DDB6" />
  <SolidColorBrush x:Key="Info" Color="#8FB8F2" />
  <SolidColorBrush x:Key="Focus" Color="#74E0C6" />
  <SolidColorBrush x:Key="Selection" Color="#2F6A60" />
  <SolidColorBrush x:Key="Hover.Fill" Color="#0FFFFFFF" />
  <SolidColorBrush x:Key="Syn.Keyword" Color="#C4A7F5" />
  <SolidColorBrush x:Key="Syn.String" Color="#A8DDA0" />
  <SolidColorBrush x:Key="Syn.Number" Color="#F1C27D" />
  <SolidColorBrush x:Key="Syn.Comment" Color="#6F7E8E" />
  <SolidColorBrush x:Key="Syn.Function" Color="#8FB8F2" />
  <SolidColorBrush x:Key="Syn.Type" Color="#74E0C6" />
  <SolidColorBrush x:Key="Syn.Plain" Color="#D7DEE7" />
  <SolidColorBrush x:Key="Code.Inline" Color="#B9EBDD" />
  <SolidColorBrush x:Key="Ink" Color="#E8EDF3" />
  <SolidColorBrush x:Key="Muted" Color="#A7B4C2" />
  <SolidColorBrush x:Key="Line" Color="#2A3847" />
  <SolidColorBrush x:Key="ContextAdvisoryInk" Color="#F1C27D" />
  <SolidColorBrush x:Key="ContextTargetInk" Color="#8FB8F2" />
  <SolidColorBrush x:Key="PopupSurface" Color="#1F2B38" />
  <SolidColorBrush x:Key="ControlTrack" Color="#18222D" />
  <SolidColorBrush x:Key="ControlThumb" Color="#7C8A99" />
  <SolidColorBrush x:Key="ControlHover" Color="#A7B4C2" />
  <SolidColorBrush x:Key="ContextWarningInk" Color="#F2777A" />

  <FontFamily x:Key="Font.UI">pack://application:,,,/Fonts/#Inter, Segoe UI</FontFamily>
  <FontFamily x:Key="Font.Mono">pack://application:,,,/Fonts/#JetBrains Mono, Cascadia Mono, Consolas</FontFamily>
  <FontFamily x:Key="Font.Icon">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

  <CornerRadius x:Key="R.XS">4</CornerRadius>
  <CornerRadius x:Key="R.S">6</CornerRadius>
  <CornerRadius x:Key="R.M">8</CornerRadius>
  <CornerRadius x:Key="R.L">12</CornerRadius>
  <CornerRadius x:Key="R.XL">16</CornerRadius>
  <CornerRadius x:Key="R.Pill">999</CornerRadius>

  <DropShadowEffect x:Key="Shadow.Popup" x:Shared="False" BlurRadius="24" ShadowDepth="8" Direction="270" Opacity="0.45" Color="#000000" />
  <DropShadowEffect x:Key="Shadow.Drawer" x:Shared="False" BlurRadius="48" ShadowDepth="0" Direction="180" Opacity="0.55" Color="#000000" />

  <Duration x:Key="Motion.Fast">0:0:0.12</Duration>
  <Duration x:Key="Motion.Base">0:0:0.18</Duration>
  <Duration x:Key="Motion.Slow">0:0:0.26</Duration>
  <CubicEase x:Key="Ease.Out" EasingMode="EaseOut" />
  <CubicEase x:Key="Ease.In" EasingMode="EaseIn" />
  <CubicEase x:Key="Ease.InOut" EasingMode="EaseInOut" />

  <!-- Type ramp -->
  <Style x:Key="Type.Display" TargetType="TextBlock"><Setter Property="FontSize" Value="28" /><Setter Property="LineHeight" Value="36" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.Title" TargetType="TextBlock"><Setter Property="FontSize" Value="20" /><Setter Property="LineHeight" Value="28" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.Subtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="16" /><Setter Property="LineHeight" Value="22" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.Body" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.BodyStrong" TargetType="TextBlock"><Setter Property="FontSize" Value="14" /><Setter Property="LineHeight" Value="20" /><Setter Property="FontWeight" Value="Medium" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.Reading" TargetType="TextBlock"><Setter Property="FontSize" Value="15" /><Setter Property="LineHeight" Value="24" /><Setter Property="Foreground" Value="{StaticResource Text.Primary}" /></Style>
  <Style x:Key="Type.Small" TargetType="TextBlock"><Setter Property="FontSize" Value="13" /><Setter Property="LineHeight" Value="18" /><Setter Property="Foreground" Value="{StaticResource Text.Secondary}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style x:Key="Type.Caption" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="Foreground" Value="{StaticResource Text.Tertiary}" /></Style>
  <Style x:Key="Type.Label" TargetType="TextBlock"><Setter Property="FontSize" Value="12" /><Setter Property="LineHeight" Value="16" /><Setter Property="FontWeight" Value="SemiBold" /><Setter Property="Foreground" Value="{StaticResource Text.Tertiary}" /><Setter Property="Margin" Value="0,24,0,8" /></Style>
  <Style x:Key="Type.Icon" TargetType="TextBlock"><Setter Property="FontFamily" Value="{StaticResource Font.Icon}" /><Setter Property="FontSize" Value="16" /><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="HorizontalAlignment" Value="Center" /></Style>
  <!-- Old key kept for existing code: section label -->
  <Style x:Key="Label" TargetType="TextBlock" BasedOn="{StaticResource Type.Label}"><Setter Property="Margin" Value="0,16,0,6" /></Style>
</ResourceDictionary>
